# 세 값 모두 필수다. 로컬은 .env.local에, Vercel은 Production과 Preview 환경 둘 다에 넣는다.
# (하나라도 빠지면 Preview 배포에서 로그인 또는 관리자 원본 삭제가 실패한다)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# 서버 전용(관리자 신분증 원본 삭제 API). NEXT_PUBLIC_ 붙이지 말 것. Production·Preview 모두 필수
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
