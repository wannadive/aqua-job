# 세 값 모두 필수다. 로컬은 .env.local에, Vercel은 Production과 Preview 환경 둘 다에 넣는다.
# (하나라도 빠지면 Preview 배포에서 로그인 또는 관리자 원본 삭제가 실패한다)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# 서버 전용(관리자 신분증 원본 삭제 API). NEXT_PUBLIC_ 붙이지 말 것. Production·Preview 모두 필수
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# 웹 푸시(010 알림). 키는 한 번 만들어 Production·Preview·로컬에 똑같이 넣는다(바꾸면 기기들이 다시 알림을 켜야 함).
#   VAPID 키 만들기: npx web-push generate-vapid-keys  → Public Key / Private Key
#   비밀값 만들기:   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY는 브라우저에 공개되는 값(구독용), 나머지 셋은 서버 전용 — NEXT_PUBLIC_ 붙이지 말 것.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<vapid-public-key>
VAPID_PRIVATE_KEY=<vapid-private-key>
VAPID_SUBJECT=mailto:<운영자 이메일>
# DB 트리거가 /api/push/flush를 부를 때 싣는 비밀값. DB의 aqua_push_config('flush_secret')에도 같은 값을 넣는다.
PUSH_FLUSH_SECRET=<랜덤 32바이트 이상>
